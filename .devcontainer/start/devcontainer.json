{
  "name": "TanStack Start for Svelte Demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "cd start && npm install",
  "postAttachCommand": {
    "dev": "cd start && npm run dev -- --host"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Start dev server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["svelte.svelte-vscode"]
    }
  }
}
